{
  "$schema": "https://turborepo.org/schema.json",
  "globalDependencies": [
    "**/.env",
    "**/.env.local"
  ],
  "pipeline": {
    "dev": {
      "cache": false,
      "persistent": true,
      "outputs": [
        "$TURBO_CACHE"
      ]
    },
    "build": {
      "outputs": [
        ".next/**",
        "dist/**",
        "build/**"
      ],
      "cache": true,
      "dependsOn": [
        "^build"
      ]
    },
    "lint": {
      "outputs": [
        ".eslintcache"
      ],
      "cache": true,
      "dependsOn": [
        "^build"
      ]
    },
    "test": {
      "outputs": [
        "coverage/**"
      ],
      "cache": true,
      "dependsOn": [
        "^build"
      ]
    },
    "type-check": {
      "cache": true,
      "dependsOn": [
        "^build"
      ]
    }
  }
}
