# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/roadlyn
REDIS_URL=redis://localhost:6379

# API
API_PORT=3001
API_NODE_ENV=development
API_LOG_LEVEL=debug

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_APP_NAME=Roadlyn
WEB_APP_URL=http://localhost:3000

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRATION=7d
OAUTH_TOKEN_ISSUER=roadlyn-api

# GitHub OAuth user login
# Callback URL to add in GitHub OAuth app: http://localhost:3001/api/auth/github/callback
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
GITHUB_OAUTH_CALLBACK_URL=http://localhost:3001/api/auth/github/callback

# AI provider key encryption (minimum 32 chars; rotate with a migration plan)
AI_KEY_ENCRYPTION_SECRET=change-me-to-a-32-character-minimum-secret

# Third-party services
SENDGRID_API_KEY=
STRIPE_API_KEY=
